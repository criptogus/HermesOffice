{
  "id": "com.hermesoffice.app",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "24.08",
  "sdk": "org.freedesktop.Sdk",
  "base": "org.electronjs.Electron2.BaseApp",
  "base-version": "24.08",
  "command": "hermesoffice",
  "separate-locales": false,
  "finish-args": [
    "--share=ipc",
    "--socket=x11",
    "--socket=wayland",
    "--device=dri",
    "--share=network",
    "--filesystem=home",
    "--talk-name=org.freedesktop.Notifications",
    "--talk-name=org.freedesktop.secrets",
    "--talk-name=org.freedesktop.portal.Desktop"
  ],
  "modules": [
    {
      "name": "hermesoffice",
      "buildsystem": "simple",
      "sources": [
        {
          "type": "file",
          "path": "hermesoffice.sh"
        },
        {
          "type": "file",
          "path": "apply_extra"
        },
        {
          "type": "file",
          "path": "com.hermesoffice.app.desktop"
        },
        {
          "type": "file",
          "path": "com.hermesoffice.app.metainfo.xml"
        },
        {
          "type": "file",
          "path": "../../apps/shell/build/icons/16x16.png"
        },
        {
          "type": "file",
          "path": "../../apps/shell/build/icons/32x32.png"
        },
        {
          "type": "file",
          "path": "../../apps/shell/build/icons/48x48.png"
        },
        {
          "type": "file",
          "path": "../../apps/shell/build/icons/64x64.png"
        },
        {
          "type": "file",
          "path": "../../apps/shell/build/icons/128x128.png"
        },
        {
          "type": "file",
          "path": "../../apps/shell/build/icons/256x256.png"
        },
        {
          "type": "file",
          "path": "../../apps/shell/build/icons/512x512.png"
        },
        {
          "type": "file",
          "path": "../../apps/shell/build/icons/1024x1024.png"
        },
        {
          "type": "extra-data",
          "filename": "hermesoffice.deb",
          "only-arches": ["x86_64"],
          "url": "https://github.com/criptogus/HermesOffice/releases/download/v0.11.0/hermesoffice_0.11.0_amd64.deb",
          "sha256": "a59241bd30dcee12314990f7d438ec2bc4a5e93c5c1c242b203361529dc44c29",
          "size": 147161680,
          "x-checker-data": {
            "type": "json",
            "url": "https://api.github.com/repos/criptogus/HermesOffice/releases/latest",
            "version-query": ".tag_name | sub(\"^v\"; \"\")",
            "url-query": ".assets[] | select(.name | endswith(\"_amd64.deb\")) | .browser_download_url"
          }
        }
      ],
      "build-commands": [
        "install -Dm755 hermesoffice.sh /app/bin/hermesoffice",
        "install -Dm755 apply_extra /app/bin/apply_extra",
        "install -Dm644 com.hermesoffice.app.desktop /app/share/applications/com.hermesoffice.app.desktop",
        "install -Dm644 com.hermesoffice.app.metainfo.xml /app/share/metainfo/com.hermesoffice.app.metainfo.xml",
        "install -Dm644 16x16.png /app/share/icons/hicolor/16x16/apps/com.hermesoffice.app.png",
        "install -Dm644 32x32.png /app/share/icons/hicolor/32x32/apps/com.hermesoffice.app.png",
        "install -Dm644 48x48.png /app/share/icons/hicolor/48x48/apps/com.hermesoffice.app.png",
        "install -Dm644 64x64.png /app/share/icons/hicolor/64x64/apps/com.hermesoffice.app.png",
        "install -Dm644 128x128.png /app/share/icons/hicolor/128x128/apps/com.hermesoffice.app.png",
        "install -Dm644 256x256.png /app/share/icons/hicolor/256x256/apps/com.hermesoffice.app.png",
        "install -Dm644 512x512.png /app/share/icons/hicolor/512x512/apps/com.hermesoffice.app.png",
        "install -Dm644 1024x1024.png /app/share/icons/hicolor/1024x1024/apps/com.hermesoffice.app.png"
      ]
    }
  ]
}
